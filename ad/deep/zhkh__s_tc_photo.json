{"causesTitle": "Почему нет уверенности, что работы на объектах сделаны?", "causes": [{"id": "s_tc_photo_c1", "text": "выезжать на каждый объект некому"}, {"id": "s_tc_photo_c2", "text": "фото присылают без места и даты"}, {"id": "s_tc_photo_c3", "text": "подрядчик сам отчитывается о себе"}], "needs": [{"id": "insight", "text": "Видеть по каждому объекту, что сделано"}, {"id": "compliance", "text": "Подтверждать работы для проверяющих"}, {"id": "fot", "text": "Проверять объекты тем же штатом"}, {"id": "deadlines", "text": "Не срывать сроки работ"}, {"id": "speed", "text": "Быстрее принимать работы"}], "impacts": [{"id": "money", "text": "Платим за работы, которые не сделаны"}, {"id": "fines", "text": "Штрафы и претензии"}, {"id": "complaints", "text": "Жалобы жителей и проверки"}, {"id": "deadlines", "text": "Сорванные сроки"}, {"id": "reputation", "text": "Вопросы от руководства и регулятора"}], "systems": [{"id": "gis", "text": "Геоинформационная система, карты объектов"}, {"id": "sed_other", "text": "Система электронного документооборота"}, {"id": "excel_mail", "text": "Таблицы и почта"}, {"id": "bitrix", "text": "Корпоративный портал, таск-трекер"}, {"id": "scada", "text": "Телеметрия, датчики, видеонаблюдение"}, {"id": "1c", "text": "Учётная система: бухгалтерия, кадры"}, {"id": "estimate", "text": "Сметные программы"}]}
{"causesTitle": "Почему план-график закупок расходится с реальными закупками?", "causes": [{"id": "s_pr_plan_c1", "text": "план ведут в Excel отдельно от факта"}, {"id": "s_pr_plan_c2", "text": "потребности от служб собирают письмами"}, {"id": "s_pr_plan_c3", "text": "о сдвиге сроков поставок узнают поздно"}], "needs": [{"id": "insight", "text": "Видеть план и факт закупок в одном месте"}, {"id": "deadlines", "text": "Не срывать сроки закупок и поставок"}, {"id": "compliance", "text": "Соблюдать требования к плану-графику"}, {"id": "quality", "text": "Меньше правок и переносов в плане"}, {"id": "speed", "text": "Быстрее собирать потребности от служб"}], "impacts": [{"id": "deadlines", "text": "Срываются поставки и ремонты"}, {"id": "fines", "text": "Штрафы и претензии за нарушения в закупках"}, {"id": "reputation", "text": "Вопросы от руководства и регулятора"}, {"id": "overtime", "text": "Переработки при пересборке плана"}, {"id": "money", "text": "Срочные закупки обходятся дороже"}], "systems": [{"id": "excel_mail", "text": "Таблицы и почта"}, {"id": "1c", "text": "Учётная система: бухгалтерия, кадры"}, {"id": "sed_other", "text": "Система электронного документооборота"}, {"id": "gov_sed", "text": "Ведомственные государственные информационные системы"}, {"id": "estimate", "text": "Сметные программы"}, {"id": "bitrix", "text": "Корпоративный портал, таск-трекер"}]}
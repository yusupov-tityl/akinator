{"causesTitle": "Почему нет уверенности, что подрядчик сделал работы?", "causes": [{"id": "s_tc_photo_c1", "text": "на каждый объект выехать некому"}, {"id": "s_tc_photo_c2", "text": "фото присылают без места и даты"}, {"id": "s_tc_photo_c3", "text": "подрядчик сам отчитывается о себе"}], "needs": [{"id": "insight", "text": "Видеть по каждому объекту, что сделано"}, {"id": "compliance", "text": "Подтверждать выполнение для проверяющих"}, {"id": "fot", "text": "Справляться тем же штатом"}, {"id": "deadlines", "text": "Не срывать сроки"}, {"id": "speed", "text": "Быстрее принимать работы"}], "impacts": [{"id": "money", "text": "Платим за работы, которых нет"}, {"id": "complaints", "text": "Жалобы и проверки"}, {"id": "reputation", "text": "Вопросы от руководства и регулятора"}, {"id": "deadlines", "text": "Сорванные сроки"}, {"id": "fines", "text": "Штрафы и претензии"}], "systems": [{"id": "sed_other", "text": "Система электронного документооборота"}, {"id": "gov_sed", "text": "Межведомственный документооборот, ведомственные ГИС"}, {"id": "gis", "text": "Геоинформационная система, карты объектов"}, {"id": "excel_mail", "text": "Таблицы и почта"}, {"id": "bitrix", "text": "Корпоративный портал, таск-трекер"}, {"id": "1c", "text": "Учётная система: бухгалтерия, кадры"}]}
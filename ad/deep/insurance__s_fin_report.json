{"causesTitle": "Почему отчёт приходится собирать из разных систем и силами нескольких человек?", "causes": [{"id": "s_fin_report_c1", "text": "данные лежат в разных системах и в куче таблиц"}, {"id": "s_fin_report_c2", "text": "вышестоящие часто меняют формы отчётов"}, {"id": "s_fin_report_c3", "text": "цифры из разных систем не сходятся, ищут ошибку"}], "needs": [{"id": "speed", "text": "Собирать отчёт быстрее"}, {"id": "quality", "text": "Меньше ошибок и расхождений в цифрах"}, {"id": "deadlines", "text": "Сдавать отчёты в срок"}, {"id": "insight", "text": "Видеть картину целиком"}, {"id": "compliance", "text": "Соответствовать требованиям регулятора"}], "impacts": [{"id": "fines", "text": "Штрафы и претензии регулятора"}, {"id": "deadlines", "text": "Сорванные сроки сдачи отчёта"}, {"id": "overtime", "text": "Переработки и текучка"}, {"id": "reputation", "text": "Вопросы от руководства и регулятора"}], "systems": [{"id": "ins_core", "text": "Учётная страховая система"}, {"id": "1c", "text": "Учётная система: бухгалтерия, кадры"}, {"id": "excel_mail", "text": "Таблицы и почта"}, {"id": "sed_other", "text": "Система электронного документооборота"}, {"id": "crm", "text": "CRM-система"}]}
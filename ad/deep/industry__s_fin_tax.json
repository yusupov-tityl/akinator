{"causesTitle": "Почему налоговый учёт и ответы ФНС забирают столько времени?", "causes": [{"id": "s_fin_tax_c1", "text": "требования ФНС приходят пачками"}, {"id": "s_fin_tax_c2", "text": "учётные правила знает пара человек"}, {"id": "s_fin_tax_c3", "text": "коды ОКОФ и сроки подбирают вручную"}], "needs": [{"id": "speed", "text": "Быстрее готовить ответы и отчётность"}, {"id": "quality", "text": "Меньше ошибок и возвратов"}, {"id": "deadlines", "text": "Не срывать сроки ответов ФНС"}, {"id": "fot", "text": "Справляться тем же штатом"}, {"id": "compliance", "text": "Соблюдать требования налогового учёта"}], "impacts": [{"id": "fines", "text": "Штрафы и претензии от налоговой"}, {"id": "deadlines", "text": "Сорванные сроки ответов"}, {"id": "overtime", "text": "Переработки и текучка в бухгалтерии"}, {"id": "money", "text": "Потерянные деньги"}, {"id": "reputation", "text": "Вопросы от руководства и регулятора"}], "systems": [{"id": "1c", "text": "Учётная система: бухгалтерия, кадры"}, {"id": "sed_other", "text": "Система электронного документооборота"}, {"id": "excel_mail", "text": "Таблицы и почта"}, {"id": "erp", "text": "ERP-система"}]}
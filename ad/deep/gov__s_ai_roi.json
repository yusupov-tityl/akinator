{"causesTitle": "Почему пилоты ИИ не дают отдачи в деньгах?", "causes": [{"id": "s_ai_roi_c1", "text": "пилоты выбирали по моде, а не под задачи ведомства"}, {"id": "s_ai_roi_c2", "text": "данные не готовы к работе с ИИ"}, {"id": "s_ai_roi_c3", "text": "облако запрещено, а в закрытом контуре сложно"}], "needs": [{"id": "speed", "text": "Быстрее исполнять поручения и обращения"}, {"id": "fot", "text": "Справляться тем же штатом"}, {"id": "quality", "text": "Меньше ошибок и возвратов на доработку"}, {"id": "insight", "text": "Видеть эффект от пилотов в цифрах"}, {"id": "compliance", "text": "Соответствовать требованиям регуляторов"}], "impacts": [{"id": "money", "text": "Бюджет потрачен, а экономии нет"}, {"id": "reputation", "text": "Вопросы от руководства и регулятора"}, {"id": "overtime", "text": "Сотрудники по-прежнему работают вручную"}, {"id": "deadlines", "text": "Сорванные сроки"}], "systems": [{"id": "sed_other", "text": "Система электронного документооборота"}, {"id": "gov_sed", "text": "Межведомственный документооборот, ведомственные ГИС"}, {"id": "1c", "text": "Учётная система: бухгалтерия, кадры"}, {"id": "excel_mail", "text": "Таблицы и почта"}, {"id": "bitrix", "text": "Корпоративный портал, таск-трекер"}]}
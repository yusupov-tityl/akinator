{"causesTitle": "Почему проверка контрагента занимает целый день?", "causes": [{"id": "s_leg_cp_c1", "text": "сотрудники вручную смотрят 5–10 реестров"}, {"id": "s_leg_cp_c2", "text": "нет общего правила, что считать риском"}], "needs": [{"id": "speed", "text": "Проверять контрагента за минуты, а не за день"}, {"id": "quality", "text": "Меньше ошибок в проверках"}, {"id": "fot", "text": "Справляться тем же штатом"}, {"id": "compliance", "text": "Соблюдать требования закона"}, {"id": "insight", "text": "Видеть все риски по контрагенту сразу"}], "impacts": [{"id": "deadlines", "text": "Задержки с договорами и закупками"}, {"id": "fines", "text": "Штрафы и претензии контролирующих органов"}, {"id": "reputation", "text": "Вопросы от руководства и регулятора"}, {"id": "overtime", "text": "Переработки сотрудников"}], "systems": [{"id": "sed_other", "text": "Система электронного документооборота"}, {"id": "gov_sed", "text": "Межведомственный документооборот, ведомственные ГИС"}, {"id": "1c", "text": "Учётная система: бухгалтерия, закупки"}, {"id": "bitrix", "text": "Корпоративный портал, таск-трекер"}, {"id": "excel_mail", "text": "Таблицы и почта"}]}
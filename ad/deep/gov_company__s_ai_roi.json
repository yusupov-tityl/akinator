{"causesTitle": "Почему от пилотов ИИ нет отдачи в деньгах?", "causes": [{"id": "s_ai_roi_c1", "text": "пилоты выбирали по моде, а не под задачи процесса"}, {"id": "s_ai_roi_c2", "text": "данные не готовы к работе с ИИ"}, {"id": "s_ai_roi_c3", "text": "облако нельзя, а в закрытом контуре всё сложно"}], "needs": [{"id": "speed", "text": "Ускорить работу процессов"}, {"id": "fot", "text": "Справляться тем же штатом"}, {"id": "quality", "text": "Меньше ошибок и возвратов"}, {"id": "insight", "text": "Видеть картину целиком"}, {"id": "compliance", "text": "Соответствовать требованиям"}], "impacts": [{"id": "money", "text": "Потерянные деньги"}, {"id": "reputation", "text": "Вопросы от руководства и регулятора"}, {"id": "overtime", "text": "Переработки и текучка"}, {"id": "deadlines", "text": "Сорванные сроки"}], "systems": [{"id": "1c", "text": "Учётная система: бухгалтерия, кадры"}, {"id": "sed_other", "text": "Система электронного документооборота"}, {"id": "gov_sed", "text": "Межведомственный документооборот, ведомственные ГИС"}, {"id": "bitrix", "text": "Корпоративный портал, таск-трекер"}, {"id": "excel_mail", "text": "Таблицы и почта"}]}
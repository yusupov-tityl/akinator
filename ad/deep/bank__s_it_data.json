{"causesTitle": "Почему данные для аналитики и ИИ не удаётся собрать вместе?", "causes": [{"id": "s_it_data_c1", "text": "документы лежат в сканах и почте"}, {"id": "s_it_data_c2", "text": "у каждой системы свои справочники"}, {"id": "s_it_data_c3", "text": "качество данных никто не проверяет"}], "needs": [{"id": "insight", "text": "Видеть картину по клиентам и рискам целиком"}, {"id": "quality", "text": "Меньше ошибок в данных и отчётах"}, {"id": "speed", "text": "Быстрее собирать данные для отчётов и моделей"}, {"id": "compliance", "text": "Соответствовать требованиям регулятора"}], "impacts": [{"id": "reputation", "text": "Вопросы от руководства и регулятора"}, {"id": "fines", "text": "Штрафы и претензии по отчётности"}, {"id": "deadlines", "text": "Сорванные сроки отчётов и проектов"}, {"id": "money", "text": "Упущенная выгода из-за неточных данных"}, {"id": "overtime", "text": "Переработки аналитиков на ручной сборе"}], "systems": [{"id": "abs", "text": "Автоматизированная банковская система"}, {"id": "crm", "text": "CRM-система"}, {"id": "sed_other", "text": "Система электронного документооборота"}, {"id": "1c", "text": "Учётная система: бухгалтерия, кадры"}, {"id": "excel_mail", "text": "Таблицы и почта"}]}
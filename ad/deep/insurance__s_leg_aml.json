{"causesTitle": "Почему ложных тревог в мониторинге операций так много?", "causes": [{"id": "s_leg_aml_c1", "text": "правила слишком жёсткие и ловят всё подряд"}, {"id": "s_leg_aml_c2", "text": "каждую тревогу разбирают вручную"}, {"id": "s_leg_aml_c3", "text": "данные о клиенте лежат в разных системах"}], "needs": [{"id": "speed", "text": "Быстрее разбирать тревоги"}, {"id": "fot", "text": "Справляться тем же штатом"}, {"id": "compliance", "text": "Не пропускать реальные нарушения"}, {"id": "insight", "text": "Видеть клиента и его операции целиком"}], "impacts": [{"id": "fines", "text": "Штрафы и претензии регулятора"}, {"id": "deadlines", "text": "Сорванные сроки разбора тревог"}, {"id": "overtime", "text": "Переработки и текучка аналитиков"}, {"id": "reputation", "text": "Вопросы от руководства и регулятора"}], "systems": [{"id": "ins_core", "text": "Учётная страховая система"}, {"id": "crm", "text": "CRM-система"}, {"id": "excel_mail", "text": "Таблицы и почта"}, {"id": "1c", "text": "Учётная система: бухгалтерия, кадры"}, {"id": "sed_other", "text": "Система электронного документооборота"}]}
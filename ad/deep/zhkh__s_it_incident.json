{"causesTitle": "Почему инциденты на сетях разбирают так долго?", "causes": [{"id": "s_it_incident_c1", "text": "сигналов с датчиков много, а важные тонут в шуме"}, {"id": "s_it_incident_c2", "text": "решения прошлых аварий и инцидентов не найти"}, {"id": "s_it_incident_c3", "text": "причину ищут вручную по журналам и разным системам"}], "needs": [{"id": "speed", "text": "Быстрее разбирать инциденты"}, {"id": "deadlines", "text": "Укладываться в сроки устранения"}, {"id": "quality", "text": "Меньше повторных аварий и возвратов"}, {"id": "insight", "text": "Видеть картину по сетям целиком"}, {"id": "fot", "text": "Справляться тем же штатом"}], "impacts": [{"id": "deadlines", "text": "Срываем сроки устранения аварий"}, {"id": "complaints", "text": "Жалобы жителей и проверки"}, {"id": "fines", "text": "Штрафы и претензии"}, {"id": "overtime", "text": "Переработки и текучка дежурных"}, {"id": "reputation", "text": "Вопросы от руководства и регулятора"}], "systems": [{"id": "scada", "text": "Телеметрия, датчики, видеонаблюдение"}, {"id": "gis", "text": "Геоинформационная система, карты объектов"}, {"id": "bitrix", "text": "Корпоративный портал, таск-трекер"}, {"id": "sed_other", "text": "Система электронного документооборота"}, {"id": "gov_sed", "text": "Межведомственный документооборот, ведомственные ГИС"}, {"id": "excel_mail", "text": "Таблицы и почта"}]}